code-remote() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: code-remote <ssh-host> <remote-path>"
    return 1
  fi

  local host="$1"
  local absolute_path

  absolute_path=$(
    printf '%s\n' "$2" | ssh "$host" '
      realpath_command=$(command -v realpath) || exit 1
      IFS= read -r path || exit 1
      eval "path=$path"
      "$realpath_command" -e -- "$path"
    '
  ) || return 1

  code --remote "ssh-remote+$host" "$absolute_path"
}
